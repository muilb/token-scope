@echo off
setlocal
rem Launcher for Task Scheduler / manual use. Runs the server from its own
rem directory so .env and data/ resolve, and appends stdout+stderr to
rem data\server.log (data\ is gitignored).
rem
rem Do NOT edit this file while the server it launched is running: cmd reads a
rem batch file by byte offset, so when node exits the parent cmd resumes inside
rem the *new* contents at the old offset and executes whatever is there.
cd /d "%~dp0"
if not exist data mkdir data

rem Port: PORT= from .env, else the server default. Used only for the
rem already-running check below.
set "PORT=8787"
if exist ".env" for /f "usebackq eol=# tokens=1,* delims==" %%A in (".env") do (
  if /i "%%A"=="PORT" set "PORT=%%B"
)

rem Already listening? Then another instance owns the port AND the log file
rem (cmd's >> does not share-write, so a second appender would fail anyway).
rem Exit quietly so re-running the task while the server is up is a no-op.
netstat -ano -p tcp | findstr /r /c:":%PORT% .*LISTENING" >nul 2>&1
if not errorlevel 1 exit /b 0

rem Rotate the log once it passes ~20 MB. Only at start, so a very long-running
rem instance can still grow past that.
for %%F in ("data\server.log") do if exist "%%~F" if %%~zF GTR 20000000 (
  move /y "data\server.log" "data\server.log.1" >nul
)

rem Prefer node on PATH; fall back to the default install location, since a
rem scheduled task can start with a leaner environment than a user shell.
set "NODE=node"
where node >nul 2>&1 || set "NODE=C:\Program Files\nodejs\node.exe"

echo [%date% %time%] start-server.cmd: launching with "%NODE%" >> "data\server.log"
"%NODE%" --env-file-if-exists=.env server.js >> "data\server.log" 2>&1
echo [%date% %time%] start-server.cmd: server exited with code %ERRORLEVEL% >> "data\server.log"
